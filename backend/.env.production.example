# ===========================================
# HIPO Backend - Production Environment
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=3000
API_URL=https://api.yourdomain.com

# ===========================================
# Supabase PostgreSQL Database
# ===========================================
# Supabase Dashboard > Settings > Database > Connection string
# 반드시 풀러(6543)를 쓸 것. 직접 연결(5432)은 커넥션을 금방 소진한다.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true

# 전용 스키마 (기본값: hipo)
# HIPO 는 테이블이 100개다. 다른 앱과 같은 DB 를 쓸 때 public 에 쏟으면
# users/products/orders/posts 등 12개 이름이 충돌한다. 반드시 격리할 것.
# 스키마는 서버 기동 시 자동 생성된다.
DB_SCHEMA=hipo

# 개발에서 sync({ alter: true }) 를 끄고 싶을 때 false
# (프로덕션에서는 환경변수와 무관하게 항상 꺼진다)
# DB_SYNC_ALTER=false

# ===========================================
# JWT Configuration (반드시 변경!)
# ===========================================
# 64자 이상의 랜덤 문자열 사용
# 생성 명령어: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=7d

# ===========================================
# AWS S3 (파일 업로드)
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=hipo-uploads

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=*
SOCKET_CORS_ORIGIN=*

# 브라우저에서 API 를 부르는 프론트엔드 도메인 (쉼표로 여러 개).
# server.js 의 기본 허용 목록(localhost, hipo.app)에 더해진다.
#
# 반드시 설정할 것. 여기 없는 도메인에서 온 요청은 500 으로 거절되고,
# 브라우저에는 "서버에 연결할 수 없습니다"처럼 원인과 무관한 오류로 보인다.
ADDITIONAL_CORS_ORIGINS=https://your-web-domain

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Toss Payments (실서비스용)
# ===========================================
# https://www.tosspayments.com 에서 발급
TOSS_CLIENT_KEY=live_ck_...
TOSS_SECRET_KEY=live_sk_...

# ===========================================
# Optional: External APIs
# ===========================================
# News API
NEWS_API_KEY=

# Naver API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube API
YOUTUBE_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# ===========================================
# 클라이언트 / OAuth
# ===========================================
# 로그인 성공 후 돌아갈 웹 주소 (하드코딩된 localhost:8081 대체)
CLIENT_URL=https://your-web-domain

# 앱 딥링크 스킴. frontend/app.json 의 expo.scheme 과 같아야 한다
APP_SCHEME=hipo

